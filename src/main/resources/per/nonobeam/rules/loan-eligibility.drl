package per.nonobeam.rules

unit LoanEligibilityUnit

import per.nonobeam.rules.web.model.request.LoanRequest;
import per.nonobeam.rules.web.model.core.LoanDecision;

rule "Reject underage or no income"
when
    $r: /requests[ age < 18 || salary == 0 ]
then
    $r.setDecision(LoanDecision.REJECTED);
    firedRules.add("Reject underage/no income");
    logs.add("Age=" + $r.getAge() + ", Salary=" + $r.getSalary());
end

rule "Reject too much debt"
when
    $r: /requests[ currentDebt > 5 * salary ]
then
    $r.setDecision(LoanDecision.REJECTED);
    firedRules.add("Reject too much debt");
    logs.add("Debt=" + $r.getCurrentDebt());
end

rule "Reject loan too large"
when
    $r: /requests[ loanAmount > 12 * salary ]
then
    $r.setDecision(LoanDecision.REJECTED);
    firedRules.add("Reject too large");
    logs.add("LoanAmount=" + $r.getLoanAmount());
end

rule "Approve high credit & stable job"
when
    $r: /requests[
        creditScore > 750 && yearsEmployed > 5 &&
        employerReputation > 80 && !hasDefaultHistory
    ]
then
    $r.setDecision(LoanDecision.APPROVED);
    firedRules.add("Approve high credit/stability");
    logs.add("Credit=" + $r.getCreditScore());
end

rule "Flag first-time low-score"
when
    $r: /requests[
        isFirstTimeBorrower && creditScore < 600
    ]
then
    $r.setDecision(LoanDecision.REVIEW);
    firedRules.add("Review first-time low credit");
    logs.add("FirstTime, Credit=" + $r.getCreditScore());
end

rule "Review luxury loan"
when
    $r: /requests[
        purposeOfLoan == "wedding" || purposeOfLoan == "travel"
    ]
then
    $r.setDecision(LoanDecision.REVIEW);
    firedRules.add("Review luxury purpose");
    logs.add("Purpose=" + $r.getPurposeOfLoan());
end

rule "Reject risky region"
when
    $r: /requests[
        region == "zone3" || region == "zone5"
    ]
then
    $r.setDecision(LoanDecision.REVIEW);
    firedRules.add("Review risky region");
    logs.add("Region=" + $r.getRegion());
end

rule "Review long term"
when
    $r: /requests[ loanTermMonths > 84 ]
then
    $r.setDecision(LoanDecision.REVIEW);
    firedRules.add("Review long term");
    logs.add("TermMonths=" + $r.getLoanTermMonths());
end

rule "Reject no home & many dependents"
when
    $r: /requests[ homeOwnership == "none" && numberOfDependents > 3 ]
then
    $r.setDecision(LoanDecision.REJECTED);
    firedRules.add("Reject no home dependents");
    logs.add("Dependents=" + $r.getNumberOfDependents());
end

// Default fallback
rule "Default Review"
when
    $r: /requests[ decision == null ]
then
    $r.setDecision(LoanDecision.REVIEW);
    firedRules.add("Default to Review");
end
